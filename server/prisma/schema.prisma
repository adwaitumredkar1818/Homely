generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  name      String
  role      String    @default("TENANT")
  createdAt DateTime  @default(now())
  
  // Relations
  rooms     Room[]    @relation("UserRooms")
  bookings  Booking[] @relation("UserBookings")
  sentMessages      Message[] @relation("SentMessages")
  receivedMessages  Message[] @relation("ReceivedMessages")
  reviews   Review[]
  messes        Mess[]    // Added: Host can own messes
  messBookings  MessSubscription[]
  messReviews   MessReview[]
}

model Room {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  price       Float
  location    String
  lat         Float
  lng         Float
  amenities   String
  messes      String   @default("[]")
  createdAt   DateTime @default(now())

  // Relations
  hostId      Int
  host        User      @relation("UserRooms", fields: [hostId], references: [id])
  images      Image[]
  bookings    Booking[]
  reviews     Review[]
  nearbyMesses Mess[]   @relation("RoomMesses") // Added: M-N relation to standalone Mess entity
}

model Image {
  id      Int    @id @default(autoincrement())
  url     String
  roomId  Int
  room    Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Booking {
  id         Int       @id @default(autoincrement())
  startDate  DateTime
  endDate    DateTime
  totalPrice Float
  status     String    @default("PENDING") // PENDING, CONFIRMED, CANCELLED
  createdAt  DateTime  @default(now())

  // Relations
  roomId     Int
  room       Room      @relation(fields: [roomId], references: [id])
  tenantId   Int
  tenant     User      @relation("UserBookings", fields: [tenantId], references: [id])
}

model Message {
  id        Int     @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  
  senderId    Int
  sender      User    @relation("SentMessages", fields: [senderId], references: [id])
  receiverId  Int
  receiver    User    @relation("ReceivedMessages", fields: [receiverId], references: [id])
}

model Review {
  id             Int      @id @default(autoincrement())
  cleanliness    Int      @default(5)
  accuracy       Int      @default(5)
  communication  Int      @default(5)
  location       Int      @default(5)
  value          Int      @default(5)
  overallRating  Float
  comment        String
  hostResponse   String?
  createdAt      DateTime @default(now())

  // Relations
  userId         Int
  user           User     @relation(fields: [userId], references: [id])
  roomId         Int
  room           Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Mess {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Float    @default(3000)
  location    String
  lat         Float
  lng         Float
  type        String   @default("VEG") // VEG, NON_VEG, BOTH
  createdAt   DateTime @default(now())

  // Relations
  rooms         Room[]             @relation("RoomMesses")
  images        MessImage[]
  reviews       MessReview[]
  subscriptions MessSubscription[]
  hostId        Int
  host          User               @relation(fields: [hostId], references: [id])
}

model MessImage {
  id     Int    @id @default(autoincrement())
  url    String
  messId Int
  mess   Mess   @relation(fields: [messId], references: [id], onDelete: Cascade)
}

model MessSubscription {
  id         Int      @id @default(autoincrement())
  type       String   @default("MONTHLY") // TRIAL, MONTHLY
  totalPrice Float
  status     String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED
  createdAt  DateTime @default(now())

  // Relations
  messId     Int
  mess       Mess     @relation(fields: [messId], references: [id])
  tenantId   Int
  tenant     User     @relation(fields: [tenantId], references: [id])
}

model MessReview {
  id             Int      @id @default(autoincrement())
  taste          Int      @default(5)
  hygiene        Int      @default(5)
  variety        Int      @default(5)
  value          Int      @default(5)
  overallRating  Float
  comment        String
  hostResponse   String?
  createdAt      DateTime @default(now())

  // Relations
  userId         Int
  user           User     @relation(fields: [userId], references: [id])
  messId         Int
  mess           Mess     @relation(fields: [messId], references: [id], onDelete: Cascade)
}
