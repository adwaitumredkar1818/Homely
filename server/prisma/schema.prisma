generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  name      String
  role      String    @default("TENANT")
  createdAt DateTime  @default(now())
  // Trust & Verification
  isVerified      Boolean   @default(false)
  idProofUrl      String?
  studentIdUrl    String?

  // Vibe Profile
  college          String?
  studyPreference  String?
  socialPreference String?
  cleanlinessLevel Int       @default(3)
  isSmoking        Boolean   @default(false)
  isVegetarian     Boolean   @default(false)
  bio              String?

  // Relations
  rooms     Room[]    @relation("UserRooms")
  bookings  Booking[] @relation("UserBookings")
  sentMessages      Message[] @relation("SentMessages")
  receivedMessages  Message[] @relation("ReceivedMessages")
  reviews   Review[]
  messes        Mess[]
  messBookings  MessSubscription[]
  messReviews   MessReview[]
  wishlist      Wishlist[]
  maintenanceRequests MaintenanceRequest[]
  notifications       Notification[]
  roommateListings    RoommateListing[]
}

model Room {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  price       Float
  location    String
  lat         Float
  lng         Float
  amenities   String
  messes      String   @default("[]")
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Relations
  hostId      Int
  host        User      @relation("UserRooms", fields: [hostId], references: [id])
  images      Image[]
  bookings    Booking[]
  reviews     Review[]
  nearbyMesses Mess[]   @relation("RoomMesses")
  wishlist     Wishlist[]
  maintenanceRequests MaintenanceRequest[]
  roommateListings    RoommateListing[]
}

model Image {
  id      Int    @id @default(autoincrement())
  url     String
  roomId  Int
  room    Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Booking {
  id         Int       @id @default(autoincrement())
  startDate  DateTime
  endDate    DateTime
  totalPrice Float
  status     String    @default("PENDING") // PENDING, CONFIRMED, CANCELLED
  createdAt  DateTime  @default(now())

  isGroup      Boolean @default(false)
  groupMembers GroupMember[]

  // Relations
  roomId     Int
  room       Room      @relation(fields: [roomId], references: [id])
  tenantId   Int
  tenant     User      @relation("UserBookings", fields: [tenantId], references: [id])
  roommateListing RoommateListing?
}

model Message {
  id        Int     @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  
  senderId    Int
  sender      User    @relation("SentMessages", fields: [senderId], references: [id])
  receiverId  Int
  receiver    User    @relation("ReceivedMessages", fields: [receiverId], references: [id])
}

model Review {
  id             Int      @id @default(autoincrement())
  cleanliness    Int      @default(5)
  accuracy       Int      @default(5)
  communication  Int      @default(5)
  location       Int      @default(5)
  value          Int      @default(5)
  overallRating  Float
  comment        String
  imageUrl       String?
  hostResponse   String?
  createdAt      DateTime @default(now())

  // Relations
  userId         Int
  user           User     @relation(fields: [userId], references: [id])
  roomId         Int
  room           Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Mess {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Float    @default(3000)
  location    String
  lat         Float
  lng         Float
  type        String   @default("VEG") // VEG, NON_VEG, BOTH
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Relations
  rooms         Room[]             @relation("RoomMesses")
  images        MessImage[]
  reviews       MessReview[]
  subscriptions MessSubscription[]
  hostId        Int
  host          User               @relation(fields: [hostId], references: [id])
  wishlist      Wishlist[]
}

model MessImage {
  id     Int    @id @default(autoincrement())
  url    String
  messId Int
  mess   Mess   @relation(fields: [messId], references: [id], onDelete: Cascade)
}

model MessSubscription {
  id         Int      @id @default(autoincrement())
  type       String   @default("MONTHLY") // TRIAL, MONTHLY
  totalPrice Float
  status     String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED
  createdAt  DateTime @default(now())

  // Relations
  messId     Int
  mess       Mess     @relation(fields: [messId], references: [id])
  tenantId   Int
  tenant     User     @relation(fields: [tenantId], references: [id])
}

model MessReview {
  id             Int      @id @default(autoincrement())
  taste          Int      @default(5)
  hygiene        Int      @default(5)
  variety        Int      @default(5)
  value          Int      @default(5)
  overallRating  Float
  comment        String
  imageUrl       String?
  hostResponse   String?
  createdAt      DateTime @default(now())

  // Relations
  userId         Int
  user           User     @relation(fields: [userId], references: [id])
  messId         Int
  mess           Mess     @relation(fields: [messId], references: [id], onDelete: Cascade)
}

model MaintenanceRequest {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, RESOLVED
  priority    String   @default("MEDIUM")  // LOW, MEDIUM, HIGH
  imageUrl    String?
  hostResponse String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  roomId      Int?
  room        Room?    @relation(fields: [roomId], references: [id])
}

model Wishlist {
  id      Int  @id @default(autoincrement())
  userId  Int
  user    User @relation(fields: [userId], references: [id])
  roomId  Int?
  room    Room? @relation(fields: [roomId], references: [id])
  messId  Int?
  mess    Mess? @relation(fields: [messId], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // e.g. "BOOKING", "MESSAGE", "MAINTENANCE"
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}



model GroupMember {
  id        Int      @id @default(autoincrement())
  bookingId Int
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId    Int
  status    String   @default("PENDING") // PENDING, ACCEPTED, DECLINED
  createdAt DateTime @default(now())
}

model RoommateListing {
  id               Int      @id @default(autoincrement())
  title            String
  description      String
  budget           Float
  location         String
  moveInDate       DateTime
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  studyPreference  String?
  socialPreference String?
  cleanlinessLevel Int      @default(3)
  isSmoking        Boolean  @default(false)
  isVegetarian     Boolean  @default(false)

  // Relations
  posterId         Int
  poster           User     @relation(fields: [posterId], references: [id])
  bookingId        Int      @unique
  booking          Booking  @relation(fields: [bookingId], references: [id])
  roomId           Int
  room             Room     @relation(fields: [roomId], references: [id])
}
