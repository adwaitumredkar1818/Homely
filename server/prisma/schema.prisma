generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  name      String
  role      String    @default("TENANT")
  createdAt DateTime  @default(now())
  // Trust & Verification
  isVerified      Boolean   @default(false)
  idProofUrl      String?
  studentIdUrl    String?

  // Lifestyle Preferences (For Matchmaking)
  bio               String?   @default("No bio provided.")
  college           String?
  studyPreference   String?   @default("NEUTRAL") // MORNING, NIGHT, NEUTRAL
  cleanlinessLevel  Int?      @default(3)         // 1-5
  socialPreference  String?   @default("NEUTRAL") // INTROVERT, EXTROVERT, NEUTRAL
  isSmoking         Boolean?  @default(false)
  isVegetarian      Boolean?  @default(false)
  hobbies           String?   @default("[]")      // JSON string of tags

  // Relations
  rooms     Room[]    @relation("UserRooms")
  bookings  Booking[] @relation("UserBookings")
  sentMessages      Message[] @relation("SentMessages")
  receivedMessages  Message[] @relation("ReceivedMessages")
  reviews   Review[]
  messes        Mess[]
  messBookings  MessSubscription[]
  messReviews   MessReview[]
  wishlist      Wishlist[]
  maintenanceRequests MaintenanceRequest[]
  
  // Financial Relations
  payments    Payment[]
  paidExpenses Expense[] @relation("PayerExpenses")
  expenseShares ExpenseSplit[]
}

model Room {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  price       Float
  location    String
  lat         Float
  lng         Float
  amenities   String
  messes      String   @default("[]")
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Relations
  hostId      Int
  host        User      @relation("UserRooms", fields: [hostId], references: [id])
  images      Image[]
  bookings    Booking[]
  reviews     Review[]
  nearbyMesses Mess[]   @relation("RoomMesses")
  wishlist     Wishlist[]
  maintenanceRequests MaintenanceRequest[]
}

model Image {
  id      Int    @id @default(autoincrement())
  url         String
  isPanorama  Boolean  @default(false)
  roomId      Int
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Booking {
  id         Int       @id @default(autoincrement())
  startDate  DateTime
  endDate    DateTime
  totalPrice Float
  status     String    @default("PENDING") // PENDING, CONFIRMED, CANCELLED
  createdAt  DateTime  @default(now())

  // Relations
  roomId     Int
  room       Room      @relation(fields: [roomId], references: [id])
  tenantId   Int
  tenant     User      @relation("UserBookings", fields: [tenantId], references: [id])
}

model Message {
  id        Int     @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  
  senderId    Int
  sender      User    @relation("SentMessages", fields: [senderId], references: [id])
  receiverId  Int
  receiver    User    @relation("ReceivedMessages", fields: [receiverId], references: [id])
}

model Review {
  id             Int      @id @default(autoincrement())
  cleanliness    Int      @default(5)
  accuracy       Int      @default(5)
  communication  Int      @default(5)
  location       Int      @default(5)
  value          Int      @default(5)
  overallRating  Float
  comment        String
  imageUrl       String?
  hostResponse   String?
  createdAt      DateTime @default(now())

  // Relations
  userId         Int
  user           User     @relation(fields: [userId], references: [id])
  roomId         Int
  room           Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Mess {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Float    @default(3000)
  location    String
  lat         Float
  lng         Float
  type        String   @default("VEG") // VEG, NON_VEG, BOTH
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Relations
  rooms         Room[]             @relation("RoomMesses")
  images        MessImage[]
  reviews       MessReview[]
  subscriptions MessSubscription[]
  hostId        Int
  host          User               @relation(fields: [hostId], references: [id])
  wishlist      Wishlist[]
}

model MessImage {
  id     Int    @id @default(autoincrement())
  url         String
  isPanorama  Boolean  @default(false)
  messId      Int
  mess        Mess     @relation(fields: [messId], references: [id], onDelete: Cascade)
}

model MessSubscription {
  id         Int      @id @default(autoincrement())
  type       String   @default("MONTHLY") // TRIAL, MONTHLY
  totalPrice Float
  status     String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED
  createdAt  DateTime @default(now())

  // Relations
  messId     Int
  mess       Mess     @relation(fields: [messId], references: [id])
  tenantId   Int
  tenant     User     @relation(fields: [tenantId], references: [id])
}

model MessReview {
  id             Int      @id @default(autoincrement())
  taste          Int      @default(5)
  hygiene        Int      @default(5)
  variety        Int      @default(5)
  value          Int      @default(5)
  overallRating  Float
  comment        String
  imageUrl       String?
  hostResponse   String?
  createdAt      DateTime @default(now())

  // Relations
  userId         Int
  user           User     @relation(fields: [userId], references: [id])
  messId         Int
  mess           Mess     @relation(fields: [messId], references: [id], onDelete: Cascade)
}

model MaintenanceRequest {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, RESOLVED
  priority    String   @default("MEDIUM")  // LOW, MEDIUM, HIGH
  imageUrl    String?
  hostResponse String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  roomId      Int?
  room        Room?    @relation(fields: [roomId], references: [id])
}

model Wishlist {
  id      Int  @id @default(autoincrement())
  userId  Int
  user    User @relation(fields: [userId], references: [id])
  roomId  Int?
  room    Room? @relation(fields: [roomId], references: [id])
  messId  Int?
  mess    Mess? @relation(fields: [messId], references: [id])
}

model Payment {
  id        Int      @id @default(autoincrement())
  amount    Float
  status    String   @default("PENDING") // PENDING, COMPLETED, FAILED
  type      String   // RENT, MESS, UTILITY, OTHER
  provider  String?  // UPI, CARD, CASH
  reference String?  // Transaction ID
  createdAt DateTime @default(now())

  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  
  // Optional links
  bookingId Int?
  subscriptionId Int?
}

model Expense {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  amount      Float
  category    String   @default("GENERAL") // FOOD, UTILITIES, RENT, OTHER
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  // The user who paid the bill initially
  payerId     Int
  payer       User     @relation("PayerExpenses", fields: [payerId], references: [id])

  // Relations
  splits      ExpenseSplit[]
}

model ExpenseSplit {
  id        Int      @id @default(autoincrement())
  amount    Float    // The share of this user
  status    String   @default("UNPAID") // UNPAID, PAID
  
  expenseId Int
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}


